---
import Base from "../layouts/Base.astro";
---

<Base title="Harry Qin" description="Harry Qin, software engineer in Melbourne." home>
  <div class="top">
    <div>
      <h1>Harry Qin</h1>
      <h2>Software Engineer</h2>
    </div>
    <ul>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/resume.pdf" target="_blank" rel="noopener">Résumé</a></li>
      <li><a href="https://github.com/HarryQin99" target="_blank" rel="noopener">GitHub</a></li>
      <li><a href="mailto:harryqinyf@outlook.com">Email</a></li>
    </ul>
  </div>
  <section class="now">
    <h3>Now</h3>
    <!-- Edit this line whenever what you're doing changes. -->
    <p>Senior Software Engineer at Heidi, working on the commerce platform.</p>
  </section>
</Base>

<style>
  .top {
    max-width: 760px;
    margin: 20vh auto 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 32px;
  }
  h1 { font-size: 40px; margin: 0 0 8px; }
  h2 { font-size: 20px; font-weight: 400; color: var(--soft); margin: 0; }
  .now { max-width: 760px; margin: 72px auto 0; }
  h3 { font-size: 13px; font-weight: 500; color: var(--faint); margin: 0 0 8px; text-transform: none; }
  .now p { margin: 0; color: var(--ink); }
  ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 24px; }
  li { font-size: 17px; }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .top { flex-direction: column; gap: 28px; margin-top: 14vh; }
    .now { margin-top: 48px; }
    ul { flex-wrap: wrap; gap: 12px 20px; }
  }
</style>
