---
import Base from "../layouts/Base.astro";

const roles = [
  { org: "Heidi", title: "Senior Software Engineer", years: "2026 –" },
  { org: "EditXiaobian", title: "Founding Engineer", years: "2026" },
  { org: "Block (Cash App)", title: "Software Engineer", years: "2024 – 2026" },
  { org: "Bukalapak", title: "Software Engineer", years: "2022 – 2024" },
  { org: "eBay, ByteDance", title: "Intern", years: "2021" },
];
---

<Base title="About · Harry Qin" description="Four years as a backend engineer, mostly on event-driven services.">
  <h1>About</h1>
  <p class="lead">Four years as a backend engineer, mostly on event-driven services.</p>
  <ul class="list">
    {
      roles.map((r) => (
        <li>
          <span>
            {r.org} <span class="d">{r.title}</span>
          </span>
          <span class="y">{r.years}</span>
        </li>
      ))
    }
  </ul>
  <p class="school">University of Melbourne, Computer and Software Engineering.</p>
</Base>

<style>
  .school { margin-top: 24px; }
</style>
