---
import { getImage } from "astro:assets";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import harry from "../assets/harry.jpg";

interface Props {
  title: string;
  description?: string;
  /** The home page is the name itself, so it skips the back-to-home header. */
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const ogImage = await getImage({ src: harry, width: 1200, format: "jpg" });
const ogImageUrl = new URL(ogImage.src, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a stored choice before first paint; white is the default.
      try {
        if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
  </head>
  <body>
    <ThemeToggle />
    <div class={home ? "home" : "wrap"}>
      {
        !home && (
          <header>
            <a class="me" href="/">Harry Qin</a>
          </header>
        )
      }
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  header { margin-bottom: 48px; font-size: 15px; }
  .me { font-weight: 600; text-decoration: none; }
</style>
