---
import { getImage } from "astro:assets";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import harry from "../assets/harry.jpg";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const ogImage = await getImage({ src: harry, width: 1200, format: "jpg" });
const ogImageUrl = new URL(ogImage.src, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a stored theme before first paint; otherwise CSS follows the system setting.
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
  </head>
  <body>
    <ThemeToggle />
    <div class="wrap">
      <header>
        <a class="me" href="/">Harry Qin</a>
        <nav>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/resume.pdf" target="_blank" rel="noopener">Résumé</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 64px;
    font-size: 15px;
  }
  .me { font-weight: 600; text-decoration: none; }
  nav { display: flex; gap: 20px; color: var(--soft); }
  nav a { text-decoration: none; }
  nav a:hover { color: var(--ink); }
  @media (max-width: 560px) {
    header { flex-direction: column; gap: 8px; margin-bottom: 48px; }
  }
</style>
